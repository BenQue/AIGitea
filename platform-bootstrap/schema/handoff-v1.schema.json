{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "platform-bootstrap handoff v1",
  "type": "object",
  "properties": {
    "contract_version": {
      "enum": [
        "platform-bootstrap-handoff/v1"
      ]
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_name": {
      "enum": [
        "platform-bootstrap.tar.gz"
      ]
    }
  },
  "required": [
    "contract_version",
    "source_sha",
    "manifest_sha256",
    "archive_sha256",
    "archive_name"
  ],
  "additionalProperties": false
}
