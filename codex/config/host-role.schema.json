{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisoft-platform.local/schemas/host-role/1.0",
  "title": "AISoftPlatform host role profile",
  "description": "Credential-free identity and capability contract for one managed host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "host_id",
    "hostname",
    "role",
    "allowed_capabilities",
    "profile_revision",
    "managed_by"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "host_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Lowercase /etc/machine-id value."
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?$"
    },
    "role": {
      "enum": [
        "scm-ci",
        "appserver-test",
        "appserver-prod"
      ]
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
      }
    },
    "profile_revision": {
      "type": "integer",
      "minimum": 1
    },
    "managed_by": {
      "const": "aisoft-platform"
    }
  }
}
