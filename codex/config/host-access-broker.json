{
  "contract_version": "host-access-broker/v1",
  "environment": "local-orbstack",
  "site": {
    "gitea_url": "http://gitea-ci.orb.local:3000",
    "orbstack_machine": "gitea-ci",
    "orbstack_user": "benque",
    "credential_root_mac": "/Users/benque/Library/Application Support/AISoftPlatform/credentials",
    "credential_root_vm": "/home/benque/.config/aisoft/credentials",
    "platform_checkout_mac": "/Users/benque/MyDocs/AISoftPlatform",
    "platform_checkout_vm": "/mnt/mac/Users/benque/MyDocs/AISoftPlatform",
    "npm_registry": "http://gitea-ci.orb.local:4873/"
  },
  "governance_contract_version": "gitea-governance/v1",
  "human_merge_identity": "admin",
  "identity_bindings": {
    "manager_audit": {
      "identity": "aisoft-platform-manager",
      "credential_kind": "protected-file",
      "relative_path": "manager/audit.token"
    },
    "manager_mutation": {
      "identity": "aisoft-platform-manager",
      "credential_kind": "protected-file",
      "relative_path": "manager/mutation.token"
    },
    "project_agent": {
      "credential_kind": "protected-file",
      "relative_path_template": "projects/{project_id}/project-agent.token",
      "account_source": "manifest-project-agent"
    }
  },
  "mac_host": {
    "credential_owner": "benque",
    "credential_directory_mode": "700",
    "credential_file_mode": "600",
    "credential_helper": "/usr/local/libexec/aisoft/git-credential-aisoft-host",
    "orbstack_binary": "/usr/local/bin/orb"
  },
  "vm_runtime": {
    "runtime_user": "coder"
  },
  "operations": [
    {
      "name": "gitea.credential.rotate",
      "identity_route": "credential-operator",
      "mutating": true,
      "arguments": [
        "issue",
        "sha",
        "token_kind"
      ]
    },
    {
      "name": "gitea.repo.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "gitea.dependency.read",
      "identity_route": "manager-audit",
      "mutating": false,
      "arguments": [
        "reference"
      ]
    },
    {
      "name": "gitea.issue.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "number"
      ]
    },
    {
      "name": "gitea.issue.list",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "state"
      ]
    },
    {
      "name": "gitea.issue.create",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "title",
        "body",
        "entry_label"
      ]
    },
    {
      "name": "gitea.issue.update",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "title",
        "body"
      ]
    },
    {
      "name": "gitea.issue.state.set",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "state"
      ]
    },
    {
      "name": "gitea.issue.comment",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "comment"
      ]
    },
    {
      "name": "gitea.issue.comments.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "number"
      ]
    },
    {
      "name": "gitea.pulls.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "state"
      ]
    },
    {
      "name": "gitea.pull.create",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "issue",
        "title",
        "body"
      ]
    },
    {
      "name": "gitea.pull.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "number"
      ]
    },
    {
      "name": "gitea.pull.update",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "issue",
        "title",
        "body"
      ]
    },
    {
      "name": "gitea.commit.status.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "sha"
      ]
    },
    {
      "name": "gitea.actions.run.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "sha"
      ]
    },
    {
      "name": "gitea.actions.job.logs.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "job"
      ]
    },
    {
      "name": "gitea.labels.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "gitea.labels.provision",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": []
    },
    {
      "name": "gitea.labels.extension.define",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "label",
        "color",
        "description"
      ]
    },
    {
      "name": "gitea.issue.labels.read",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "number"
      ]
    },
    {
      "name": "gitea.issue.labels.set",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "lifecycle"
      ]
    },
    {
      "name": "gitea.issue.labels.extension.set",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "label"
      ]
    },
    {
      "name": "gitea.issue.labels.classify",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "number",
        "change_type",
        "complexity"
      ]
    },
    {
      "name": "gitea.protection.read",
      "identity_route": "manager-audit",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "host.access.audit",
      "identity_route": "manager-audit",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "host.onboarding.check",
      "identity_route": "manager-audit",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "git.fetch.main",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "git.fetch.change",
      "identity_route": "project-agent",
      "mutating": false,
      "arguments": [
        "branch"
      ]
    },
    {
      "name": "git.push.change",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": [
        "branch"
      ]
    },
    {
      "name": "mac.git.bind",
      "identity_route": "project-agent",
      "mutating": true,
      "arguments": []
    },
    {
      "name": "orbstack.vm.status",
      "identity_route": "host-operator",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "orbstack.runner.status",
      "identity_route": "host-operator",
      "mutating": false,
      "arguments": []
    },
    {
      "name": "orbstack.vm.units.read",
      "identity_route": "host-operator",
      "mutating": false,
      "arguments": []
    }
  ],
  "projects": [
    {
      "project_id": "aisoft-platform",
      "repository": "aisoft-platform",
      "project_agent": "aisoft-platform-agent",
      "mac_checkout": "/Users/benque/MyDocs/AISoftPlatform"
    },
    {
      "project_id": "hsdb",
      "repository": "HSDB",
      "project_agent": "hsdb-agent",
      "mac_checkout": "/Users/benque/Projects/HSDB"
    },
    {
      "project_id": "localwms",
      "repository": "LocalWMS",
      "project_agent": "localwms-agent",
      "mac_checkout": "/Users/benque/Projects/LocalWMS"
    },
    {
      "project_id": "myapp",
      "repository": "myapp",
      "project_agent": "myapp-agent",
      "mac_checkout": null
    },
    {
      "project_id": "newemaint",
      "repository": "NewEMaint",
      "project_agent": "newemaint-agent",
      "git_remote_name": "gitea",
      "mac_checkout": "/Users/benque/Projects/NewEmaint"
    },
    {
      "project_id": "sfm-digital-board",
      "repository": "SFMDigitalBoard",
      "project_agent": "sfm-board-agent",
      "git_remote_name": "gitea",
      "mac_checkout": "/Users/benque/Projects/SFMDigitalBoard",
      "dependency_read_targets": [
        "aisoft-platform"
      ]
    },
    {
      "project_id": "smoke-test",
      "repository": "smoke-test",
      "project_agent": "smoke-test-agent",
      "mac_checkout": null
    }
  ],
  "credential_rotation_policy": {
    "operator_uid": 0,
    "grant_root": "/usr/local/etc/aisoft/credential-rotation-grants",
    "source_receipt": "/usr/local/share/aisoft/credential-rotation-source.json",
    "vm_helper": "/usr/local/libexec/aisoft/gitea-pat-helper",
    "vm_operator": "/usr/local/libexec/aisoft/rotate-gitea-service-account",
    "vm_service_user": "git",
    "gitea_binary": "/usr/local/bin/gitea",
    "gitea_config": "/etc/gitea/app.ini",
    "gitea_version": "1.26.4"
  }
}
