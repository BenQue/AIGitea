#!/usr/bin/env bash
# aisoft: the one session entry point a project uses (#402, R11).
#
# One source file, two landings. In the platform repository it is
# codex/tools/aisoft and runs the tools next to it. A project receives it as
# .aisoft/bin/aisoft together with .aisoft/lib/, a copy of the platform tree
# subset those tools need (usage/bundle.json lists every file; the
# tool-provenance check pins their bytes to the project's lock). The wrapped
# tools keep their own relative lookups because .aisoft/lib mirrors the platform
# layout. Manifests are not part of that copy: the tools fall back to the
# host-access broker install under /usr/local/share/aisoft, and every Gitea or
# Git call still goes through the installed broker.
set -euo pipefail
set +x

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "$here/../lib/codex/tools" ]]; then
  layout=project
  root="$(cd -- "$here/../lib" && pwd)"
else
  layout=source
  root="$(cd -- "$here/../.." && pwd)"
fi
tools="$root/codex/tools"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$root/codex/runtime${PYTHONPATH:+:$PYTHONPATH}"

usage_text() {
  cat <<'USAGE'
usage: aisoft <command> [args]

  change-name N SLUG                    validate and print a new change branch
  resolve-documents N                   mapped change document names (JSON)
  check-change-documents [--porcelain]  front matter contract across the checkout
  open-pr N --title T --body-file F     after confirmation point 2: push, open the PR, backfill, push
  backfill-pr-url N --pr-url URL        manual repair: record the unique PR in the mapped summary
  claim-worktree --branch B [...]       bind this change worktree to AISOFT_SESSION_ID
  scan-worktrees [--porcelain]          read-only: change worktrees left their last push
  classify N... | --apply N... | --verify N...
                                        classification projection (plan shows the route card)
  complete --project ID (--range R | --apply N...)
                                        terminal lifecycle after merge (dry-run without --apply)
  project-check [--kind software|docs] [--remote] [--today D]
  bundle status                         this checkout against its pinned bundle release
  version                               bundle_version, bundle_digest and source SHA

Every command takes --repo DIR; the default is the current git top level.
USAGE
}

usage() {
  usage_text >&2
  exit 64
}

# aisoft <command> --help prints that command's lines of the usage text.
command_help() {
  usage_text | awk -v name="$1" '
    $0 ~ "^  " name "( |$)" { show = 1; print; next }
    show && /^      / { print; next }
    { show = 0 }
  '
}

# --repo is optional for the caller and mandatory for every wrapped tool: a
# wrapped tool's own default is its install root, which inside a project is
# .aisoft/lib and never the checkout being worked on.
repo=""
args=()
while (($# > 0)); do
  case "$1" in
    --repo)
      (($# >= 2)) || usage
      repo="$2"
      shift 2
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
((${#args[@]} > 0)) || usage
command="${args[0]}"
args=("${args[@]:1}")
for arg in ${args[@]+"${args[@]}"}; do
  if [[ "$arg" == --help || "$arg" == -h ]]; then
    help="$(command_help "$command")"
    [[ -n "$help" ]] || usage
    printf '%s\n' "$help"
    exit 0
  fi
done
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo 'aisoft: not inside a git checkout; pass --repo DIR' >&2
    exit 2
  }
fi
repo="$(cd -- "$repo" && pwd)"

cli() {
  python3 -m aisoft_loop.cli "$@"
}

route_card() {
  python3 - "$repo" "$1" <<'PY'
import sys
from aisoft_loop.contract import ContractError, resolve_summary

repo, issue = sys.argv[1], int(sys.argv[2])
try:
    path, front_matter = resolve_summary(repo, issue)
except (ContractError, OSError, ValueError) as error:
    print(f"路由 #{issue}: 读不出映射 summary：{error}")
    sys.exit(0)
route = front_matter.get("route")
if not isinstance(route, dict):
    print(f"路由 #{issue}: summary 未写 route:，按 aisoft-platform 技能的 references/route-policy.md 查表补写")
else:
    print(
        f"路由 #{issue}: {route['process']} · {route['tier']}/{route['effort']} · {route['method']}"
        f" · verify {route['verify']} · review {route['review']} · skills {route['skills']}"
    )
PY
}

# open-pr (#408): one command after confirmation point 2. The body is checked
# against the broker's body contract before any broker call; every remote step
# goes through the broker from inside the checkout (the broker resolves the
# checkout by its cwd). A rerun is safe: pull.create returns the open PR of the
# same change, and a summary that already carries that URL is not committed.
open_pr() {
  local issue="" title="" body_file=""
  while (($# > 0)); do
    case "$1" in
      --title) (($# >= 2)) || usage; title="$2"; shift 2 ;;
      --body-file) (($# >= 2)) || usage; body_file="$2"; shift 2 ;;
      [0-9]*) [[ -z "$issue" && "$1" =~ ^[1-9][0-9]*$ ]] || usage; issue="$1"; shift ;;
      *) usage ;;
    esac
  done
  [[ -n "$issue" && -n "$title" && -f "$body_file" ]] || usage
  local branch summary
  branch="$(git -C "$repo" branch --show-current)"
  [[ "$branch" =~ ^change/${issue}-[a-z0-9-]+$ ]] || { echo "aisoft open-pr: branch $branch is not change/$issue-<slug>" >&2; exit 2; }
  # The body is read once; the same string is checked here and sent to the
  # broker, and the check mirrors the broker's _pull_body (typed text, one
  # Closes line, exactly one semantic summary link) so a body this accepts is
  # one the broker accepts.
  local body
  body="$(cat -- "$body_file")"
  summary="$(AISOFT_PR_BODY="$body" python3 - "$repo" "$issue" <<'PY'
import os
import re
import sys
from pathlib import Path
from aisoft_change_name import SLUG_PATTERN, ChangeName, ChangeNameError
from aisoft_loop.contract import ContractError, resolve_summary

repo, issue, body = Path(sys.argv[1]), int(sys.argv[2]), os.environ["AISOFT_PR_BODY"]
try:
    path, front = resolve_summary(repo, issue)
except (ContractError, OSError, ValueError) as error:
    sys.exit(f"aisoft open-pr: mapped summary unreadable: {error}")
if front.get("status") not in {"approved", "pr-open"}:
    sys.exit(f"aisoft open-pr: summary status is {front.get('status')!r}, not approved")
relative = Path(path).resolve().relative_to(repo.resolve()).as_posix()
if not body.strip() or "\0" in body or "\r" in body:
    sys.exit("aisoft open-pr: the body is empty or carries NUL or CR characters")
if len(body.encode("utf-8")) > 65536:
    sys.exit("aisoft open-pr: the body exceeds the broker's 65536-byte limit")
if re.findall(r"(?m)^Closes #([1-9][0-9]*)[ \t]*$", body) != [str(issue)]:
    sys.exit(f"aisoft open-pr: the body must carry exactly one line 'Closes #{issue}'")
links = list(re.finditer(
    rf"(?<![A-Za-z0-9_./-])docs/changes/({issue}-({SLUG_PATTERN}))/summary-({SLUG_PATTERN})-[0-9]{{6}}\.md"
    rf"(?![A-Za-z0-9_./-])", body))
if len(links) != 1 or links[0].group(2) != links[0].group(3) or links[0].group(0) != relative:
    sys.exit(f"aisoft open-pr: the body must link {relative} and no other summary, exactly once")
try:
    ChangeName.parse_directory(links[0].group(1), issue_number=issue, allow_legacy=False)
except ChangeNameError as error:
    sys.exit(f"aisoft open-pr: {error}")
print(relative)
PY
)" || exit 2
  # Clean, or resuming a run whose backfill commit failed: then the only change
  # is this summary's pr_url and status lines.
  local dirty
  dirty="$(git -C "$repo" status --porcelain)"
  if [[ -n "$dirty" ]]; then
    if [[ "$(git -C "$repo" status --porcelain --untracked-files=all | sed 's/^...//')" != "$summary" ]] ||
      git -C "$repo" diff HEAD --unified=0 -- "$summary" | grep -E '^[-+][^-+]' | grep -Evq '^[-+](pr_url|status):'; then
      echo 'aisoft open-pr: the worktree is not clean' >&2
      exit 2
    fi
  fi
  # Same discovery as the wrapped tools: same directory first.
  local broker
  if [[ -x "$tools/host-access-broker.sh" ]]; then
    broker="$tools/host-access-broker.sh"
  elif [[ -x /usr/local/libexec/aisoft/host-access-broker ]]; then
    broker=/usr/local/libexec/aisoft/host-access-broker
  else
    echo 'aisoft open-pr: host access broker is unavailable' >&2
    exit 2
  fi
  local agent_lib="$root/codex/agent/aisoft-project-target.sh"
  # shellcheck disable=SC1090
  . "$agent_lib"
  aisoft_resolve_project_target "$tools" "$repo" "" || { echo "aisoft open-pr: $AISOFT_PROJECT_TARGET_ERROR" >&2; exit 2; }
  broker_call() {
    (cd -- "$repo" && "$broker" --project "$AISOFT_PROJECT_ID" --operation "$@")
  }
  broker_call git.push.change --branch "$branch" >/dev/null || { echo 'aisoft open-pr: first push refused (see the broker reply above)' >&2; exit 1; }
  local reply number
  reply="$(broker_call gitea.pull.create --issue "$issue" --title "$title" --body "$body")" ||
    { echo 'aisoft open-pr: pull.create refused (see the broker reply above)' >&2; exit 1; }
  number="$(python3 -c 'import json,sys; n=json.loads(sys.argv[1])["number"]; assert isinstance(n,int) and n>0; print(n)' "$reply")" ||
    { echo "aisoft open-pr: pull.create reply has no PR number: $reply" >&2; exit 1; }
  python3 - "$repo" "$issue" "$number" <<'PY' || exit 1
import sys
from aisoft_loop.contract import ContractError
from aisoft_loop.documents import backfill_pr_number

try:
    path, changed = backfill_pr_number(sys.argv[1], int(sys.argv[2]), int(sys.argv[3]))
except ContractError as error:
    sys.exit(f"aisoft open-pr: backfill refused: {error}")
print(("changed " if changed else "unchanged ") + str(path))
PY
  if [[ -n "$(git -C "$repo" status --porcelain -- "$summary")" ]]; then
    git -C "$repo" add -- "$summary"
    git -C "$repo" commit -q -m "#$issue: backfill unique PR $number URL in mapped summary" -- "$summary" || {
      echo "aisoft open-pr: committing the backfilled summary failed; fix the cause and rerun open-pr (PR $number stays)" >&2
      exit 1
    }
  fi
  [[ -z "$(git -C "$repo" status --porcelain)" ]] || { echo 'aisoft open-pr: the backfill touched more than the summary' >&2; exit 1; }
  cli check-change-documents --repo "$repo" >/dev/null || { echo 'aisoft open-pr: check-change-documents failed after the backfill' >&2; exit 1; }
  broker_call git.push.change --branch "$branch" >/dev/null || { echo 'aisoft open-pr: second push refused (see the broker reply above)' >&2; exit 1; }
  printf 'PR %s\t%s\n' "$number" "$(git -C "$repo" rev-parse HEAD)"
}

case "$command" in
  change-name)
    cli change-name ${args[@]+"${args[@]}"}
    ;;
  resolve-documents | backfill-pr-url | check-change-documents | scan-worktrees)
    cli "$command" ${args[@]+"${args[@]}"} --repo "$repo"
    ;;
  claim-worktree)
    # The worktree to claim is the checkout this run speaks about; an explicit
    # --worktree still wins, but never a silent fallback to the shell's cwd.
    worktree_given=false
    for arg in ${args[@]+"${args[@]}"}; do
      [[ "$arg" == --worktree || "$arg" == --worktree=* ]] && worktree_given=true
    done
    if [[ "$worktree_given" == true ]]; then
      cli claim-worktree ${args[@]+"${args[@]}"}
    else
      cli claim-worktree ${args[@]+"${args[@]}"} --worktree "$repo"
    fi
    ;;
  classify)
    mode=plan
    for arg in ${args[@]+"${args[@]}"}; do
      case "$arg" in
        --apply | --verify) mode=write-or-read ;;
      esac
    done
    if [[ "$mode" == plan ]]; then
      for arg in ${args[@]+"${args[@]}"}; do
        if [[ "$arg" =~ ^[0-9]+$ ]]; then
          route_card "$arg"
        fi
      done
    fi
    bash "$tools/apply-classification-labels.sh" --repo "$repo" ${args[@]+"${args[@]}"}
    ;;
  complete)
    bash "$tools/mark-completed-issues.sh" --repo "$repo" ${args[@]+"${args[@]}"}
    ;;
  project-check)
    bash "$tools/aisoft-project-check.sh" --repo "$repo" ${args[@]+"${args[@]}"}
    ;;
  bundle)
    [[ "${args[*]:-}" == status ]] || usage
    bash "$tools/usage-bundle.sh" --project-status "$repo"
    ;;
  version)
    ((${#args[@]} == 0)) || usage
    if [[ "$layout" == project ]]; then
      python3 - "$root/provenance.json" <<'PY'
import json
import sys

try:
    provenance = json.load(open(sys.argv[1], encoding="utf-8"))
    for key in ("bundle_version", "bundle_digest", "source_sha"):
        print(f"{key}\t{provenance[key]}")
except (OSError, ValueError, KeyError) as error:
    print(f"aisoft: provenance unreadable: {error}", file=sys.stderr)
    sys.exit(2)
print("layout\tproject")
PY
    else
      latest="$(python3 -c 'import json,sys; r=json.load(open(sys.argv[1]))["releases"][-1]; print(r["version"]+"\t"+r["bundle_digest"])' \
        "$root/usage/bundle.json")"
      printf 'bundle_version\tsource-tree (latest release %s)\n' "${latest%%$'\t'*}"
      printf 'bundle_digest\t%s\n' "${latest#*$'\t'}"
      printf 'source_sha\t%s\n' "$(git -C "$root" rev-parse HEAD)"
      printf 'layout\tsource\n'
    fi
    ;;
  open-pr)
    open_pr ${args[@]+"${args[@]}"}
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    echo "aisoft: unknown command: $command" >&2
    usage
    ;;
esac
