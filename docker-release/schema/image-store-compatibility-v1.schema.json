{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisoft.example/contracts/docker-release/image-store-compatibility-v1.schema.json",
  "title": "AISoft Docker image-store compatibility matrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "matrix_revision", "rows"],
  "properties": {
    "contract_version": {"const": "docker-image-store-compatibility/v1"},
    "matrix_revision": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum_exclusive"],
      "properties": {
        "minimum": {"$ref": "#/$defs/version"},
        "maximum_exclusive": {"$ref": "#/$defs/version"}
      }
    },
    "realEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence_id", "date", "source"],
      "properties": {
        "kind": {"const": "real-e2e"},
        "evidence_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "date": {"type": "string", "format": "date"},
        "source": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "evidence": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/realEvidence"}
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "engine",
        "compose",
        "os",
        "architecture",
        "image_store",
        "status",
        "evidence",
        "remediation"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "engine": {"$ref": "#/$defs/range"},
        "compose": {"$ref": "#/$defs/range"},
        "os": {"const": "linux"},
        "architecture": {"const": "amd64"},
        "image_store": {"enum": ["containerd", "classic"]},
        "status": {"enum": ["supported", "rejected"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 512}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "supported"}}},
          "then": {"properties": {"evidence": {"$ref": "#/$defs/realEvidence"}}}
        }
      ]
    }
  }
}
