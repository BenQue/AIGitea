#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_ROOT="$(cd -- "$SCRIPT_DIR/../.." && pwd)"

if [[ -d "$SOURCE_ROOT/codex/runtime/aisoft_architecture" ]]; then
  RUNTIME_ROOT="$SOURCE_ROOT/codex/runtime"
else
  RUNTIME_ROOT="$(cd -- "$SCRIPT_DIR/../lib/aisoft-architecture" && pwd)"
fi

if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="$RUNTIME_ROOT:$PYTHONPATH"
else
  export PYTHONPATH="$RUNTIME_ROOT"
fi
exec python3 -m aisoft_architecture.cli "$@"
