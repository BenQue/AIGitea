{
  "$id": "https://aisoft.example/schemas/profile-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "catalog_revision": {"pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$", "type": "string"},
    "compatibility_rules": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
    "constraints": {
      "additionalProperties": false,
      "properties": {
        "availability": {"minLength": 1, "type": "string"},
        "backup": {"minLength": 1, "type": "string"},
        "concurrency": {"minLength": 1, "type": "string"},
        "data_storage": {"minLength": 1, "type": "string"},
        "deployment": {"minLength": 1, "type": "string"},
        "restore_drill": {"minLength": 1, "type": "string"}
      },
      "required": ["deployment", "data_storage", "concurrency", "availability", "backup", "restore_drill"],
      "type": "object"
    },
    "delivery_contracts": {"items": {"enum": ["docker-release/v1", "pm2-legacy", "windows-iis/v1", "embedded-sqlite/v1", "systemd-native/v1"]}, "minItems": 1, "type": "array", "uniqueItems": true},
    "description": {"minLength": 1, "type": "string"},
    "profile_id": {"pattern": "^[a-z0-9][a-z0-9-]+$", "type": "string"},
    "required_components": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowed_states": {"items": {"enum": ["preferred", "supported", "sunset"]}, "minItems": 1, "type": "array", "uniqueItems": true},
          "component_id": {"pattern": "^[a-z0-9][a-z0-9.-]+$", "type": "string"},
          "transitions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "allowed_states": {"items": {"enum": ["supported", "sunset"]}, "minItems": 1, "type": "array", "uniqueItems": true},
                "component_id": {"pattern": "^[a-z0-9][a-z0-9.-]+$", "type": "string"}
              },
              "required": ["component_id", "allowed_states"],
              "type": "object"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": ["component_id", "allowed_states"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {"const": "1.0", "type": "string"},
    "status": {"enum": ["active", "reference"], "type": "string"},
    "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"}
  },
  "required": ["$schema", "schema_version", "profile_id", "version", "catalog_revision", "status", "description", "required_components", "compatibility_rules", "delivery_contracts", "constraints"],
  "type": "object"
}
