{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisoft.example/contracts/company-delivery/inventory-v1.schema.json",
  "title": "AISoft company delivery sanitized inventory V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "collector_version",
    "collected_at",
    "role",
    "scope",
    "outcome",
    "host",
    "tools",
    "units",
    "pending"
  ],
  "properties": {
    "contract_version": {"const": "company-delivery-inventory/v1"},
    "collector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "collected_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "role": {"enum": ["scm-ci", "appserver-prod"]},
    "scope": {"const": "company-candidate"},
    "outcome": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN"]},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname_sha256", "machine_id_sha256", "os_id", "os_version", "kernel_version", "architecture", "cpu_count", "memory_bytes", "root_free_bytes"],
      "properties": {
        "hostname_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "machine_id_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "os_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"},
        "os_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
        "kernel_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
        "architecture": {"enum": ["amd64", "arm64", "unknown"]},
        "cpu_count": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 0},
        "root_free_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "pending": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}}
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "version", "reason"],
      "properties": {
        "name": {"enum": ["act-runner", "docker-compose", "docker-engine", "git", "gitea", "nginx", "postgresql-client", "python"]},
        "status": {"enum": ["PASS", "BLOCKED", "NOT RUN"]},
        "version": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled", "active"],
      "properties": {
        "name": {"enum": ["act_runner.service", "aisoft-inbound-sync@newemaint.timer", "docker.service", "gitea.service", "nginx.service", "postgresql.service"]},
        "enabled": {"enum": ["enabled", "disabled", "masked", "static", "indirect", "not-found", "unknown"]},
        "active": {"enum": ["active", "inactive", "failed", "activating", "deactivating", "maintenance", "not-found", "unknown"]}
      }
    }
  }
}
