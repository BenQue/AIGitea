{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisoft.example/contracts/company-delivery/inventory-v1.schema.json",
  "title": "AISoft company delivery sanitized inventory V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "collector_version",
    "collected_at",
    "role",
    "scope",
    "outcome",
    "host",
    "tools",
    "units",
    "pending"
  ],
  "properties": {
    "contract_version": {"const": "company-delivery-inventory/v1"},
    "collector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "collected_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "role": {"enum": ["scm-ci", "appserver-prod"]},
    "scope": {"const": "company-candidate"},
    "outcome": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT RUN"]},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname_sha256", "machine_id_sha256", "os_id", "os_version", "kernel_version", "architecture", "cpu_count", "memory_bytes", "root_free_bytes"],
      "properties": {
        "hostname_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "machine_id_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "os_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"},
        "os_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
        "kernel_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
        "architecture": {"enum": ["amd64", "arm64", "unknown"]},
        "cpu_count": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 0},
        "root_free_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "tools": {"type": "array", "items": {"$ref": "#/$defs/tool"}},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "pending": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "NOT RUN"}}},
      "then": {
        "properties": {
          "tools": {"maxItems": 0},
          "units": {"maxItems": 0},
          "pending": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "BLOCKED"}}},
      "then": {"properties": {"pending": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "PASS"}}},
      "then": {
        "properties": {
          "host": {
            "properties": {
              "hostname_sha256": {"type": "string"},
              "machine_id_sha256": {"type": "string"},
              "os_id": {"not": {"const": "unknown"}},
              "os_version": {"not": {"const": "unknown"}},
              "kernel_version": {"not": {"const": "unknown"}},
              "architecture": {"const": "amd64"},
              "cpu_count": {"minimum": 1},
              "memory_bytes": {"minimum": 1},
              "root_free_bytes": {"minimum": 1}
            }
          },
          "tools": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/tool"},
                {"properties": {"status": {"enum": ["PASS", "ABSENT"]}}}
              ]
            }
          },
          "units": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/unit"},
                {"properties": {"enabled": {"not": {"const": "unknown"}}, "active": {"not": {"const": "unknown"}}}}
              ]
            }
          },
          "pending": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"not": {"const": "NOT RUN"}}, "role": {"const": "scm-ci"}}},
      "then": {
        "properties": {
          "tools": {
            "minItems": 6,
            "maxItems": 6,
            "allOf": [
              {"contains": {"properties": {"name": {"const": "act-runner"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "docker-compose"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "docker-engine"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "git"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "gitea"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "python"}}, "required": ["name"]}}
            ]
          },
          "units": {
            "minItems": 4,
            "maxItems": 4,
            "allOf": [
              {"contains": {"properties": {"name": {"const": "act_runner.service"}}, "required": ["name"]}},
              {"contains": {"allOf": [{"properties": {"name": {"const": "aisoft-inbound-sync@newemaint.timer"}}, "required": ["name"]}, {"oneOf": [{"properties": {"enabled": {"const": "disabled"}, "active": {"const": "inactive"}}, "required": ["enabled", "active"]}, {"properties": {"enabled": {"const": "not-found"}, "active": {"const": "not-found"}}, "required": ["enabled", "active"]}]}]}},
              {"contains": {"properties": {"name": {"const": "docker.service"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "gitea.service"}}, "required": ["name"]}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"not": {"const": "NOT RUN"}}, "role": {"const": "appserver-prod"}}},
      "then": {
        "properties": {
          "tools": {
            "minItems": 5,
            "maxItems": 5,
            "allOf": [
              {"contains": {"properties": {"name": {"const": "docker-compose"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "docker-engine"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "nginx"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "postgresql-client"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "python"}}, "required": ["name"]}}
            ]
          },
          "units": {
            "minItems": 3,
            "maxItems": 3,
            "allOf": [
              {"contains": {"properties": {"name": {"const": "docker.service"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "nginx.service"}}, "required": ["name"]}},
              {"contains": {"properties": {"name": {"const": "postgresql.service"}}, "required": ["name"]}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "PASS"}, "role": {"const": "appserver-prod"}}},
      "then": {"properties": {"tools": {"items": {"allOf": [{"$ref": "#/$defs/tool"}, {"properties": {"status": {"const": "PASS"}}}]}}}}
    },
    {
      "if": {"properties": {"outcome": {"not": {"const": "NOT RUN"}}, "tools": {"contains": {"properties": {"name": {"const": "gitea"}, "status": {"const": "ABSENT"}}, "required": ["name", "status"]}}}},
      "then": {"properties": {"units": {"contains": {"properties": {"name": {"const": "gitea.service"}, "enabled": {"const": "not-found"}, "active": {"const": "not-found"}}, "required": ["name", "enabled", "active"]}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "PASS"}, "units": {"contains": {"properties": {"name": {"const": "gitea.service"}, "enabled": {"const": "not-found"}, "active": {"const": "not-found"}}, "required": ["name", "enabled", "active"]}}}},
      "then": {"properties": {"tools": {"contains": {"properties": {"name": {"const": "gitea"}, "status": {"const": "ABSENT"}}, "required": ["name", "status"]}}}}
    },
    {
      "if": {"properties": {"outcome": {"not": {"const": "NOT RUN"}}, "tools": {"contains": {"properties": {"name": {"const": "act-runner"}, "status": {"const": "ABSENT"}}, "required": ["name", "status"]}}}},
      "then": {"properties": {"units": {"contains": {"properties": {"name": {"const": "act_runner.service"}, "enabled": {"const": "not-found"}, "active": {"const": "not-found"}}, "required": ["name", "enabled", "active"]}}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "PASS"}, "units": {"contains": {"properties": {"name": {"const": "act_runner.service"}, "enabled": {"const": "not-found"}, "active": {"const": "not-found"}}, "required": ["name", "enabled", "active"]}}}},
      "then": {"properties": {"tools": {"contains": {"properties": {"name": {"const": "act-runner"}, "status": {"const": "ABSENT"}}, "required": ["name", "status"]}}}}
    }
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "version", "reason"],
      "properties": {
        "name": {"enum": ["act-runner", "docker-compose", "docker-engine", "git", "gitea", "nginx", "postgresql-client", "python"]},
        "status": {"enum": ["PASS", "ABSENT", "BLOCKED", "NOT RUN"]},
        "version": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}},
          "then": {"properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "reason": {"const": null}}},
          "else": {
            "if": {"properties": {"status": {"const": "ABSENT"}}},
            "then": {"properties": {"name": {"enum": ["act-runner", "gitea"]}, "version": {"const": null}, "reason": {"const": "confirmed-not-installed"}}},
            "else": {"properties": {"version": {"const": null}, "reason": {"enum": ["command-missing", "probe-failed", "sensitive-output-rejected", "version-output-unrecognized"]}}}
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "enabled", "active"],
      "properties": {
        "name": {"enum": ["act_runner.service", "aisoft-inbound-sync@newemaint.timer", "docker.service", "gitea.service", "nginx.service", "postgresql.service"]},
        "enabled": {"enum": ["enabled", "disabled", "masked", "static", "indirect", "not-found", "unknown"]},
        "active": {"enum": ["active", "inactive", "failed", "activating", "deactivating", "maintenance", "not-found", "unknown"]}
      }
    }
  }
}
