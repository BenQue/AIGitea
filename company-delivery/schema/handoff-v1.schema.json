{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisoft.example/contracts/company-delivery/handoff-v1.schema.json",
  "title": "AISoft company delivery handoff V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operator_version", "created_at", "source", "release", "compatibility", "payloads"],
  "properties": {
    "contract_version": {"const": "company-delivery-handoff/v1"},
    "operator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_sha", "transport"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"},
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "transport": {"enum": ["approved-bundle", "allowlisted-github-ref"]}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "release_id", "manifest_path", "manifest_sha256", "platform", "transport"],
      "properties": {
        "contract_version": {"const": "docker-release/v2"},
        "release_id": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_path": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "platform": {"const": "linux/amd64"},
        "transport": {"const": "offline-bundle"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matrix_path", "matrix_sha256", "required_roles"],
      "properties": {
        "matrix_path": {"type": "string"},
        "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_roles": {"const": ["scm-ci", "appserver-prod"]}
      }
    },
    "payloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "mode"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "mode": {"enum": ["0600", "0644", "0755"]}
        }
      }
    }
  }
}
