{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "enum": [
        "company-platform-baseline-profile/v1"
      ]
    },
    "gitea": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "enum": [
            "/opt/aisoft/gitea/1.26.4/gitea"
          ]
        },
        "expected_version": {
          "enum": [
            "1.26.4"
          ]
        },
        "listen_ip": {
          "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "type": "integer"
        },
        "storage": {
          "enum": [
            "/var/lib/aisoft-gitea"
          ]
        },
        "unit": {
          "enum": [
            "aisoft-gitea.service"
          ]
        }
      },
      "required": [
        "unit",
        "binary",
        "expected_version",
        "listen_ip",
        "port",
        "storage"
      ],
      "type": "object"
    },
    "postgresql": {
      "additionalProperties": false,
      "properties": {
        "binary": {
          "enum": [
            "/usr/lib/postgresql/18/bin/postgres"
          ]
        },
        "cluster": {
          "pattern": "^[a-z][a-z0-9]{0,31}$",
          "type": "string"
        },
        "expected_version": {
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}(\\.[0-9]{1,3})?$",
          "type": "string"
        },
        "listen_ip": {
          "enum": [
            "127.0.0.1"
          ]
        },
        "major": {
          "enum": [
            18
          ]
        },
        "port": {
          "maximum": 65535,
          "minimum": 1024,
          "type": "integer"
        },
        "storage": {
          "pattern": "^/var/lib/postgresql/18/[a-z][a-z0-9]{0,31}$",
          "type": "string"
        },
        "unit": {
          "pattern": "^postgresql@18-[a-z][a-z0-9]{0,31}\\.service$",
          "type": "string"
        }
      },
      "required": [
        "major",
        "cluster",
        "unit",
        "binary",
        "expected_version",
        "listen_ip",
        "port",
        "storage"
      ],
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "gitea",
    "postgresql"
  ],
  "type": "object"
}
