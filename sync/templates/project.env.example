# Install as /etc/aisoft-sync/<profile>.env with mode 600.
GITHUB_URL=https://github.com/ORG/REPOSITORY.git
GITHUB_REF=refs/heads/main
GITHUB_USERNAME=github-sync
GITHUB_TOKEN_FILE=/etc/aisoft-sync/keys/PROFILE-github-token

GITEA_URL=https://git.company.internal
GITEA_OWNER=OWNER
GITEA_REPO=REPOSITORY
GITEA_GIT_URL=https://git.company.internal/OWNER/REPOSITORY.git
GITEA_USERNAME=aisoft-sync
GITEA_TOKEN_FILE=/etc/aisoft-sync/keys/PROFILE-gitea-token
