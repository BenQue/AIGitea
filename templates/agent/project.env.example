# Copy to ~/.config/aisoft/projects/<profile>.env and chmod 600.
# Never commit the populated file.
GITEA_URL=http://gitea.example.internal:3000
GITEA_OWNER=example-owner
GITEA_REPO=example-repo
AISOFT_PROJECT_ID=example-project
GITEA_IDENTITY=example-project-agent
GITEA_TOKEN_FILE=/home/coder/.config/aisoft/credentials/example-project.token
AGENT_REPO_DIR=/home/coder/work/example-repo

# Provider selection is explicit per project: claude | codex | none.
# There is no automatic fallback; an unknown or disabled provider fails closed.
# Keep implementation disabled until that project's own verification matrix passes.
ANALYSIS_PROVIDER=claude
IMPLEMENT_PROVIDER=none

# Optional per-project overrides:
# CODEX_MODEL=
# CLAUDE_MODEL=
# LOOP_MAX_ROUNDS=8
# LOOP_MAX_SAME_ROOT=3
# LOOP_PROVIDER_TIMEOUT=2700

# Optional toolchain PATH prepend. Managed profiles generate this line from the
# manifest vm_profile.path_prepend declaration (Issue #112); entries must be
# absolute paths using only [A-Za-z0-9._/-], colon-joined, keeping the :$PATH
# tail so system directories are inherited instead of copied.
# PATH=/opt/node22/bin:/home/coder/.local/bin:$PATH
